# ACE-Step engine environment. install.sh copies this to ~/AceStudio/config/engine.env,
# fills the key, and chmods it 600. Sourced by ops/bin/run-engine.sh (bash, so $HOME works).
# Keep in agreement with the variables at the top of start_api_server_macos.sh.

# Soniyo-only: where ACE-Step 1.5 is cloned (pinned commit, see RUNBOOK step 5).
SONIYO_ENGINE_DIR="$HOME/AceStudio/ACE-Step-1.5"

ACESTEP_API_HOST=127.0.0.1
ACESTEP_API_PORT=8001
# Must equal ACESTEP_API_KEY in gateway.env. Never give it to a client.
ACESTEP_API_KEY=__ENGINE_KEY__
ACESTEP_CONFIG_PATH=acestep-v15-turbo
ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-0.6B
ACESTEP_LM_BACKEND=mlx
ACESTEP_QUEUE_WORKERS=1
CHECK_UPDATE=false
