# Soniyo gateway environment. install.sh copies this to ~/AceStudio/config/gateway.env,
# fills the tokens, and chmods it 600. Sourced by ops/bin/run-gateway.sh, backup.sh,
# healthcheck.sh and update-gateway.sh. Names match gateway/src/soniyo_gateway/config.py.

# 32-byte hex secret the iPad pairs with. Rotate with ops/bin/new-token.sh.
SONIYO_OWNER_TOKEN=__OWNER_TOKEN__
SONIYO_DATA_DIR="$HOME/AceStudio"
SONIYO_HOST=127.0.0.1
SONIYO_PORT=8787
SONIYO_CORS_ORIGINS=https://__FIREBASE_PROJECT__.web.app,https://__FIREBASE_PROJECT__.firebaseapp.com,http://localhost:5173
SONIYO_ENGINE=acestep
SONIYO_ENGINE_URL=http://127.0.0.1:8001
SONIYO_ENGINE_POLL_SECONDS=3
# Must equal ACESTEP_API_KEY in engine.env.
ACESTEP_API_KEY=__ENGINE_KEY__
SONIYO_LM_CAP_SECONDS=480
SONIYO_DIT_MODEL=acestep-v15-turbo
SONIYO_LM_MODEL=acestep-5Hz-lm-0.6B
# Built SPA the gateway serves at / (update-gateway.sh builds into it).
SONIYO_WEB_DIST="$HOME/AceStudio/web-dist"
# Watchdog restart after 3 failed engine health checks. install.sh adds a sudoers
# rule allowing exactly this command without a password.
SONIYO_ENGINE_RESTART_CMD="/usr/bin/sudo -n /bin/launchctl kickstart -k system/local.acestudio.engine"
# While a job renders, health timeouts (engine alive but swapping) are tolerated this long
# before they count towards the restart. Refused connections still count at once.
SONIYO_HEALTH_BUSY_GRACE_SECONDS=900
SONIYO_LOG_DIR="$HOME/Library/Logs/AceStudio"

# Ops-only (the gateway ignores these): used by ops/bin/backup.sh.
SONIYO_BACKUP_DIR="$HOME/AceStudio/backups"
# Weekly audio rsync target: external drive or NAS path. Empty = skip.
SONIYO_BACKUP_AUDIO_DEST=
